    <string name="settings_iof_overprint_brief">Purple circles vs badges</string>
    <string name="settings_iof_overprint_sub">Purple start triangle, hollow control circles, and finish (classic IOF course symbols). Off uses filled app badges. Independent of map style — toggle anytime.</string>
