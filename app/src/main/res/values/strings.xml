    <string name="settings_route_preset_hint">Quick profiles from field tests. Fine-tune with the sliders below anytime.</string>
    <string name="settings_route_preset_brief">Ready-made route styles</string>
    <string name="settings_route_preset_precise">Precise</string>
    <string name="settings_route_preset_balanced">Balanced</string>
    <string name="settings_route_preset_flexible">Flexible</string>
    <string name="settings_route_preset_custom">Custom</string>
    <string name="settings_route_preset_precise_sub">Closer to your target air distance (±700 m; shorter road detours).</string>
    <string name="settings_route_preset_balanced_sub">Recommended default (±1500 m; longer road detours OK).</string>
    <string name="settings_route_preset_flexible_sub">Easiest to generate (±2000 m; more winding walks OK).</string>
    <string name="settings_air_tolerance_title">Air distance tolerance</string>
    <string name="settings_air_tolerance_brief">How far from target air</string>
    <string name="settings_air_tolerance_hint">How far the course air distance (straight-line / bird’s-eye between controls) may miss your chosen target. Wider tolerance makes routes easier to generate.</string>
    <string name="settings_air_tolerance_value">±%.0f m from target</string>
    <string name="settings_path_ratio_title">Walking detour limit</string>
    <string name="settings_path_ratio_brief">Max walk vs air</string>
    <string name="settings_path_ratio_hint">Reject routes if the walking/road path is longer than this multiple of the air distance. Higher allows twistier paths (e.g. 1.30× = up to 30% longer on roads).</string>
    <string name="settings_route_ratio_value">Max walk / air: %.2f×</string>
    <string name="settings_section_map">Map appearance</string>
    <string name="settings_show_air_legs">Next-control air guides</string>
    <string name="settings_show_air_legs_brief">Bird’s-eye line to next</string>
    <string name="settings_show_air_legs_sub">Show the air / bird’s-eye guide line toward the next control. This is not the walking route.</string>
    <string name="settings_show_air_labels">Air distance labels</string>
    <string name="settings_show_air_labels_brief">Meters on each guide</string>
    <string name="settings_show_air_labels_sub">Show air distance (meters) in the middle of each next-control air guide.</string>
    <string name="settings_show_walking_path">Suggested walk path</string>
    <string name="settings_show_walking_path_brief">Road route on map</string>
    <string name="settings_show_walking_path_sub">Show the suggested walking/road route between checkpoints. Off by default so the course does not reveal a path. Turn on for navigation-style guidance.</string>
    <string name="settings_show_north_lines">North lines</string>
    <string name="settings_show_north_lines_brief">True-north guide lines</string>
    <string name="settings_show_north_lines_sub">Draw faint north–south lines as alignment guides when you rotate the map. These are true-north guides, not a surveyed magnetic grid.</string>
    <string name="settings_show_you_are_here">Show my position</string>
    <string name="settings_show_you_are_here_brief">GPS dot during run</string>
    <string name="settings_show_you_are_here_sub">Show your GPS position on the map while a run is active. Off by default for a cleaner course view.</string>
    <string name="settings_include_pdf_legends">PDF control table</string>
    <string name="settings_include_pdf_legends_brief">Table under exported map</string>
    <string name="settings_include_pdf_legends_sub">When exporting a PDF, add a table under the map: control number, air distance, feature, and description. Off by default.</string>
